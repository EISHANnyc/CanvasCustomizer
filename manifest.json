{
  "manifest_version": 3,
  "name": "CanvasVibe",
  "version": "1.0.51",
  "version_name": "1.0.51",

  "description": "100% free, unmetered, non-slop theme and preset customizer for Canvas LMS.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CanvasVibe Customizer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://canvas.sfu.ca/*",
        "*://*.canvaslms.com/*"
      ],
      "css": [
        "content/theme.css"
      ],
      "js": [
        "shared/presets.js",
        "shared/canvas-styles.js",
        "content/theme-engine.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}









