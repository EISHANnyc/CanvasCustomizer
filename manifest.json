{
    "manifest_version": 3,
    "name": "CanvasCustomizer",
    "version": "1.1.1",
    "version_name": "1.1.1",
    "description": "A free way to customize Canvas.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "CanvasCustomizer"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.instructure.com/*",
                "*://canvas.sfu.ca/*",
                "*://*.canvaslms.com/*"
            ],
            "css": [
                "content/theme.css"
            ],
            "js": [
                "shared/presets.js",
                "shared/canvas-styles.js",
                "content/theme-engine.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ]
}